#!/bin/sh /etc/rc.common
# WrtDeck 在 OpenWrt 上的 procd 启动脚本

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/wrtdeck
CONF_DIR=/etc/wrtdeck
CONF="$CONF_DIR/config.json"
# 面板页面被导出到这里，由设备自带的 Web 服务器直接服务。
# 与 luci-app-wrtdeck 里的入口约定一致，两边改动要同步。
WEB_DIR=/www/wrtdeck

EXTRA_COMMANDS="token password export_web migrate_config"
EXTRA_HELP="	token          打印当前 API Token
	password       重置登录口令（忘记口令时用）
	export_web     把面板页面重新导出到 $WEB_DIR
	migrate_config 把旧版本留下的配置补齐（升级后自动执行一次）"

start_service() {
	# 首次启动时 conf 目录可能不存在，配置与 Token 都在这里生成
	mkdir -p "$CONF_DIR"

	do_export_web

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF"
	# 进程异常退出后按 5s 间隔最多重启 5 次，1 小时后重置计数
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

# do_export_web 把编进二进制的面板页面导出到 Web 根目录。
#
# 页面之所以不由这个进程直接提供，是因为设备自带的 Web 服务器才是浏览器
# 真正连的那个源：把页面放进去，它就和 LuCI 同域名、同端口、同一套加密方式，
# 于是被反向代理到公网域名时也不需要浏览器去猜设备的 IP 与端口。
# 导出失败（比如 /www 只读）不阻塞启动：面板在自己的监听地址上照样能用。
do_export_web() {
	[ -x "$PROG" ] || return 0
	"$PROG" -config "$CONF" -export-web "$WEB_DIR" >/dev/null 2>&1 ||
		logger -t wrtdeck "面板页面导出到 $WEB_DIR 失败，LuCI 里的内嵌入口可能显示不出来"
	return 0
}

stop_service() {
	# 注册表与 Token 都持久化在 /etc/wrtdeck，正常退出即可
	:
}

reload_service() {
	# 配置与注册表都通过 API 热更新，重启进程即可重新加载配置
	stop
	start
}

# token 打印当前 API Token，供脚本与运维使用
token() {
	"$PROG" -config "$CONF" -print-token
}

# password 重置登录口令。这是设备主人忘记口令时唯一的找回手段，
# 因此做成 init 的子命令，与设备上其它服务的排障方式保持一致。
password() {
	"$PROG" -config "$CONF" -reset-password -
}

# export_web 手动重新导出面板页面，升级后排障用得上。
# 名字里不能用短横线：rc.common 会直接把子命令名当函数名调用，
# 而短横线不是合法的 shell 标识符字符。
export_web() {
	do_export_web
	[ -f "$WEB_DIR/index.html" ] || echo "面板页面未导出，请检查 $WEB_DIR 是否可写"
}

# migrate_config 把旧版本留下的配置补齐成当前版本期望的形态。
#
# 目前只做一件事，但这件事必须做：1.0.0 的面板默认监听 0.0.0.0:8080，等于对整个
# 局域网裸奔；1.0.1 起改成只监听回环，对外统一走 LuCI 那个源。而 config.json 是
# 配置文件，升级时设备十有八九保留的是旧内容——apk 的默认保护规则是「/etc 下被
# 管理员改过的文件不覆盖，新文件落成 .apk-new」，opkg 认 conffiles 同理。所以光换
# 包不够，得在这里把旧默认值挪过来。
#
# 判断依据是「值恰好等于旧的出厂默认值」，而不是「版本号低于 1.0.1」：用户自己写过
# 的监听地址一律不动，只提示风险。替用户改掉他显式选择过的地址，比留着旧默认值更糟。
#
# 幂等：改过之后值就不再是旧默认值，重复执行不会二次改动。
migrate_config() {
	[ -f "$CONF" ] || return 0

	_listen="$(sed -n 's/.*"listen"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONF" | head -1)"
	[ -n "$_listen" ] || return 0

	case "$_listen" in
	0.0.0.0:8080)
		# 改前留一份：想退回旧行为时把那一行抄回去即可。
		# 备份失败（目录只读之类）不终止流程，迁移本身继续。
		cp -f "$CONF" "$CONF.pre-1.0.1" 2>/dev/null || true
		if sed 's|"listen"[[:space:]]*:[[:space:]]*"0\.0\.0\.0:8080"|"listen": "127.0.0.1:8080"|' "$CONF" > "$CONF.tmp" && mv -f "$CONF.tmp" "$CONF"; then
			logger -t wrtdeck "面板监听地址已从 0.0.0.0:8080 改为 127.0.0.1:8080，原配置备份为 $CONF.pre-1.0.1"
			echo "WrtDeck：面板监听地址已从 0.0.0.0:8080 改为 127.0.0.1:8080。"
			echo "  1.0.1 起面板不再单独对外开端口，对外访问与 LuCI 同源、同一套加密方式。"
			echo "  仍想直接访问 8080 的话，把 $CONF.pre-1.0.1 里那一行抄回去，再 restart。"
		else
			logger -t wrtdeck "改写 $CONF 的监听地址失败，请手工改成 127.0.0.1:8080"
		fi
		;;
	0.0.0.0:*)
		logger -t wrtdeck "面板监听在 $_listen，建议改为 127.0.0.1:8080，统一从 LuCI 进入"
		echo "WrtDeck：配置里 listen=$_listen，面板仍对整个局域网开放。"
		echo "  建议改成 127.0.0.1:8080（1.0.1 起的出厂默认值），对外统一走 LuCI 那个源。"
		;;
	esac
	return 0
}
