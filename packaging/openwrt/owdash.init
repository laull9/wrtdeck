#!/bin/sh /etc/rc.common
# WrtDeck 在 OpenWrt 上的 procd 启动脚本

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/owdash
CONF_DIR=/etc/owdash
CONF="$CONF_DIR/config.json"

EXTRA_COMMANDS="token"
EXTRA_HELP="	token   打印当前 API Token"

start_service() {
	# 首次启动时 conf 目录可能不存在，配置与 Token 都在这里生成
	mkdir -p "$CONF_DIR"

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF"
	# 进程异常退出后按 5s 间隔最多重启 5 次，1 小时后重置计数
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

stop_service() {
	# 注册表与 Token 都持久化在 /etc/owdash，正常退出即可
	:
}

reload_service() {
	# 配置与注册表都通过 API 热更新，重启进程即可重新加载配置
	stop
	start
}

# token 打印当前 API Token，供首次登录面板使用
token() {
	"$PROG" -config "$CONF" -print-token
}
