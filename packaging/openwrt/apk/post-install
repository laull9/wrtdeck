#!/bin/sh
# apk 首次安装后：启用并启动服务
[ -n "${IPKG_INSTROOT}" ] && exit 0

/etc/init.d/owdash enable
/etc/init.d/owdash start

echo "WrtDeck 已安装并启动。"
echo "  - 面板地址：http://<设备IP>:8080"
echo "  - 初始口令：admin（首次登录后必须立即修改，不修改的话只允许内网登录）"
echo "  - 装了 luci-app-wrtdeck 时，也可以从 LuCI 的「服务 -> WrtDeck」进入"
echo "  - 忘记口令：/etc/init.d/owdash password"
echo "  - 脚本用的 API Token：/etc/init.d/owdash token"

exit 0
