#!/bin/sh
# 安装后：首次安装才启用并启动服务，升级时保持用户当前的启停状态
[ -n "${IPKG_INSTROOT}" ] && exit 0

if [ ! -f /etc/wrtdeck/.installed ]; then
	touch /etc/wrtdeck/.installed
	/etc/init.d/wrtdeck enable
	/etc/init.d/wrtdeck start
	echo "WrtDeck 已安装并启动。"
	echo "  - 面板入口：LuCI 的「服务 → WrtDeck」（需安装 luci-app-wrtdeck，装面板时会自动带上）"
	echo "  - 面板只监听 127.0.0.1:8080，不对外暴露；对外访问与 LuCI 同一个地址、同一套加密方式"
	echo "  - 初始口令：admin，首次登录后建议立即修改"
	echo "  - 忘记口令：/etc/init.d/wrtdeck password"
	echo "  - 脚本用的 API Token：/etc/init.d/wrtdeck token"
else
	/etc/init.d/wrtdeck restart
fi

exit 0
